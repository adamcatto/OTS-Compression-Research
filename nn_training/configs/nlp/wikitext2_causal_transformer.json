{
  "domain": "nlp",
  "task": "nlp.causal_lm",
  "dataset": {
    "name": "wikitext",
    "variant": "wikitext-2-raw-v1"
  },
  "model": {
    "architecture": "causal_transformer",
    "vocab_size": 257,
    "sequence_length": 256,
    "dimension": 256,
    "depth": 6,
    "heads": 8,
    "feedforward_dimension": 1024,
    "dropout": 0.0,
    "tie_embeddings": true
  },
  "optimizer": {
    "name": "adamw",
    "lr": 0.0003,
    "betas": [0.9, 0.95],
    "weight_decay": 0.1
  },
  "scheduler": {
    "name": "warmup_cosine",
    "warmup_steps": 100,
    "min_factor": 0.1
  },
  "training": {
    "steps": 1000,
    "batch_size": 16,
    "num_workers": 0,
    "precision": "fp32",
    "device": "auto",
    "gradient_capture": "optimizer_input",
    "gradient_clip_norm": 1.0,
    "online_compression": {
      "algorithm": "ots_deltaq_v1",
      "block_size": 16384,
      "relative_squared_error": 0.0001,
      "save_predictions": true
    }
  },
  "initialization": {
    "source": "random"
  },
  "environment": {},
  "seed": 4,
  "tags": ["baseline", "nlp", "transformer"]
}
