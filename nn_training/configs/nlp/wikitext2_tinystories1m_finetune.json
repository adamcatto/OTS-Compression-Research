{
  "domain": "nlp",
  "task": "nlp.causal_lm",
  "dataset": {
    "name": "wikitext",
    "variant": "wikitext-2-raw-v1",
    "max_tokens": 100000
  },
  "model": {
    "architecture": "huggingface_causal_lm",
    "pretrained_model": "roneneldan/TinyStories-1M",
    "sequence_length": 256
  },
  "optimizer": {
    "name": "adamw",
    "lr": 0.0001,
    "betas": [0.9, 0.95],
    "weight_decay": 0.01
  },
  "scheduler": {
    "name": "warmup_cosine",
    "warmup_steps": 100,
    "min_factor": 0.1
  },
  "training": {
    "steps": 1000,
    "batch_size": 16,
    "num_workers": 0,
    "precision": "fp32",
    "device": "auto",
    "gradient_capture": "optimizer_input",
    "gradient_clip_norm": 1.0
  },
  "initialization": {
    "source": "random"
  },
  "environment": {},
  "seed": 4,
  "tags": ["finetune", "nlp", "pretrained", "tinystories"]
}
