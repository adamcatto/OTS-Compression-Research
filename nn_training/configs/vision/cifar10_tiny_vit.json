{
  "domain": "vision",
  "task": "vision.classification",
  "dataset": {
    "name": "cifar10",
    "download": true
  },
  "model": {
    "architecture": "tiny_vit",
    "image_size": 32,
    "patch_size": 4,
    "num_classes": 10,
    "dimension": 192,
    "depth": 6,
    "heads": 3,
    "mlp_ratio": 4.0,
    "dropout": 0.0
  },
  "optimizer": {
    "name": "adamw",
    "lr": 0.0003,
    "betas": [0.9, 0.999],
    "weight_decay": 0.05
  },
  "scheduler": {
    "name": "warmup_cosine",
    "warmup_steps": 100,
    "min_factor": 0.01
  },
  "training": {
    "steps": 1000,
    "batch_size": 128,
    "num_workers": 4,
    "precision": "fp32",
    "device": "auto",
    "gradient_capture": "optimizer_input"
  },
  "initialization": {
    "source": "random"
  },
  "environment": {},
  "seed": 2,
  "tags": ["baseline", "vision", "transformer"]
}
